<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="MoneyDetailsPopup" t-inherit="point_of_sale.MoneyDetailsPopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//Dialog/div" position="replace">
            <div class="money-details-multi-currency">
                <t t-set="currencyKeys" t-value="getFilteredCurrencyKeys()"/>
                <t t-set="showBaseCurrency" t-value="shouldShowBaseCurrency()"/>
                
                <t t-if="showBaseCurrency">
                    <t t-if="state.moneyDetails and Object.keys(state.moneyDetails).length &gt; 0">
                        <div class="currency-row-wrapper">
                            <div class="currency-column-wrapper">
                                <div class="currency-header-label">
                                    <t t-esc="pos.currency.name"/>
                                </div>
                                <div class="denominations-list">
                                    <t t-foreach="Object.keys(state.moneyDetails)" t-as="moneyValue" t-key="moneyValue">
                                        <div class="d-flex align-items-center justify-content-center my-1">
                                            <NumericInput class="'w-50'" tModel="[state.moneyDetails, moneyValue]" min="0"/>
                                            <label class="oe_link_icon w-25 text-center" t-att-for="moneyValue">
                                                <span class="ms-1" t-esc="env.utils.formatCurrency(_parseFloat(moneyValue), false)"/>
                                                <span class="ms-1" t-esc="pos.currency.symbol"/>
                                            </label>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
                
                <t t-foreach="currencyKeys" t-as="mdKey" t-key="mdKey">
                    <t t-if="mdKey_index % 2 == 0">
                        <div class="currency-row-wrapper">
                            <div class="currency-column-wrapper">
                                <div class="currency-header-label">
                                    <t t-esc="mdKey.replace('moneyDetails', '')"/>
                                </div>
                                <div class="denominations-list">
                                    <t t-foreach="Object.keys(state[mdKey])" t-as="moneyValue" t-key="moneyValue">
                                        <div class="d-flex align-items-center justify-content-center my-1">
                                    <NumericInput class="'w-50'" tModel="[state[mdKey], moneyValue]" min="0"/>
                                    <label class="oe_link_icon w-25 text-center" t-att-for="moneyValue">
                                        <span class="ms-1" t-esc="env.utils.formatCurrency(_parseFloat(moneyValue), false)"/>
                                                <span class="ms-1" t-esc="currency_symbol(mdKey.replace('moneyDetails', ''))"/>
                                    </label>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <t t-if="!filterCurrencyName and mdKey_index + 1 &lt; currencyKeys.length">
                                <t t-set="nextKey" t-value="currencyKeys[mdKey_index + 1]"/>
                                <div class="currency-column-wrapper">
                                    <div class="currency-header-label">
                                        <t t-esc="nextKey.replace('moneyDetails', '')"/>
                                    </div>
                                    <div class="denominations-list">
                                        <t t-foreach="Object.keys(state[nextKey])" t-as="moneyValue" t-key="moneyValue">
                                            <div class="d-flex align-items-center justify-content-center my-1">
                                                <NumericInput class="'w-50'" tModel="[state[nextKey], moneyValue]" min="0"/>
                                                <label class="oe_link_icon w-25 text-center" t-att-for="moneyValue">
                                                    <span class="ms-1" t-esc="env.utils.formatCurrency(_parseFloat(moneyValue), false)"/>
                                                    <span class="ms-1" t-esc="currency_symbol(nextKey.replace('moneyDetails', ''))"/>
                                                </label>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </t>
            </div>
        </xpath>
        <xpath expr="//h4[hasclass('total-section')]" position="replace">
            <h4 class="total-section ms-auto py-2">
                <t t-foreach="computeTotalAllCurrencywithSymbol()" t-as="total" t-key="total_index">
                    <span class="me-3">
                        <t t-esc="total"/> <t t-esc="total_value"/>
                    </span>
                </t>
            </h4>
        </xpath>
    </t>


